# Copy to .env and explicitly choose one compatible GPU; no device is selected here.
# Use nvidia-smi --query-gpu=index,uuid,name,memory.total --format=csv. Never all/auto.
GPU_DEVICE=
# Compose preserves this host selection in GPU_HOST_DEVICE and isolates it as cuda:0.
BIND_ADDRESS=127.0.0.1
HOST=127.0.0.1
PORT=8000
BACKEND=qwen-base
MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-Base
MODEL_REVISION=fd4b254389122332181a7c3db7f27e918eec64e3
EXPRESSION_MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
EXPRESSION_MODEL_REVISION=0c0e3051f131929182e2c023b9537f8b1c68adfe
DEVICE_MAP=cuda:0
DTYPE=float16
ATTN_IMPLEMENTATION=eager
HF_HOME=./models
HF_HUB_OFFLINE=0
DATA_DIR=./data
PRELOAD_MODEL=1
API_TOKEN=
ADMIN_TOKEN=
ENABLE_MCP=1
# Optional quick voice clone. Use the ASR service root (without /v1); empty disables it.
ASR_BASE_URL=
ASR_TIMEOUT_SECONDS=120
REFERENCE_DRAFT_TTL_SECONDS=600
# Browser microphone recording requires HTTPS or localhost. Configure both for direct TLS,
# or terminate HTTPS at your reverse proxy. Mount certificate paths when using Docker.
TLS_CERTFILE=
TLS_KEYFILE=
# Optional separate HTTPS entrance for LAN microphone recording; see docs/https-recording.md.
# The HTTP workbench links to this address. Use HTTPS_LOCAL_CA=1 only with the supplied
# local HTTPS proxy after exporting its public root certificate to static/local-ca.crt.
HTTPS_PUBLIC_URL=
HTTPS_LOCAL_CA=0
HTTPS_UPSTREAM=127.0.0.1:8000
QUEUE_LIMIT=8
MAX_UPLOAD_BYTES=20971520
MAX_REQUEST_BYTES=23068672
MAX_REFERENCE_SECONDS=30
MAX_TEXT_CHARS=30000
MAX_UNIT_CHARS=240
MAX_NEW_TOKENS=2048
MAX_OUTPUT_BYTES=536870912
MAX_AUDIO_SECONDS=3600
MIN_FREE_DISK_BYTES=268435456
MODEL_LOAD_TIMEOUT_SECONDS=900
GENERATION_TIMEOUT_SECONDS=180
JOB_TIMEOUT_SECONDS=3600
SYNC_TIMEOUT_SECONDS=180
FFMPEG_TIMEOUT_SECONDS=120
FFMPEG_THREADS=2
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
RUBBERBAND_BIN=rubberband
WORK_SAMPLE_RATE=24000
MP3_BITRATE=128k
# Optional build-only Debian package mirror (host URL, without /debian suffix).
DEBIAN_MIRROR=https://deb.debian.org
PIP_INDEX_URL=https://pypi.org/simple
